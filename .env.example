# ── Airtable ─────────────────────────────────────────────────────────────────
# Personal access token with data.records:read, data.records:write and
# schema.bases:read (schema scope is only needed for `npm run schema:generate`).
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=apphPJFvk2oPNeJK9

# ── Sign-in (Magistrate, Field Pro Mobile Okta) ──────────────────────────────
# Per-app credentials from the Enablement team. NPM_AUTH_TOKEN is a GitHub
# token with read:packages, needed at install time (the preinstall script
# writes it into .npmrc). Values containing & must be single-quoted because
# preinstall sources this file as shell. Who may use the app is decided by the
# SHX Team table, not by this file.
MAGISTRATE_CLIENT_ID=
MAGISTRATE_CLIENT_SECRET=
MAGISTRATE_SESSION_KEY=
NPM_AUTH_TOKEN=

# ── Login log (Neon Postgres) ────────────────────────────────────────────────
# Connection string for the database holding the login_events table. Provided
# automatically by the Neon integration on Vercel; set it here to test locally.
DATABASE_URL=
# Only if the table is named something other than login_events.
# LOGIN_EVENTS_TABLE=login_events

# ── Storage ──────────────────────────────────────────────────────────────────
DATA_DIR=./data
